{
  "pipeline": {
    "name": "rumbles-promotion",
    "roleArn": "arn:aws:iam::849445096948:role/rumbles-pipeline",
    "pipelineType": "V2",
    "artifactStore": {
      "type": "S3",
      "location": "rumbles-pipeline-artifacts-849445096948"
    },
    "stages": [
      {
        "name": "Source",
        "actions": [
          {
            "name": "AppSource",
            "actionTypeId": {
              "category": "Source",
              "owner": "AWS",
              "provider": "CodeStarSourceConnection",
              "version": "1"
            },
            "configuration": {
              "ConnectionArn": "arn:aws:codeconnections:eu-north-1:849445096948:connection/e70e301f-1be6-4f3f-aec8-ba30216004ab",
              "FullRepositoryId": "devanshpoplii/pg5-rumbles-app",
              "BranchName": "main",
              "OutputArtifactFormat": "CODE_ZIP"
            },
            "outputArtifacts": [
              { "name": "SourceOutput" }
            ]
          }
        ]
      },
      {
        "name": "Build",
        "actions": [
          {
            "name": "BuildImage",
            "actionTypeId": {
              "category": "Build",
              "owner": "AWS",
              "provider": "CodeBuild",
              "version": "1"
            },
            "configuration": {
              "ProjectName": "rumbles-build"
            },
            "inputArtifacts": [
              { "name": "SourceOutput" }
            ],
            "outputArtifacts": [
              { "name": "BuildOutput" }
            ]
          }
        ]
      },
      {
        "name": "DeployDev",
        "actions": [
          {
            "name": "PromoteToDev",
            "actionTypeId": {
              "category": "Build",
              "owner": "AWS",
              "provider": "CodeBuild",
              "version": "1"
            },
            "configuration": {
              "ProjectName": "rumbles-deploy-dev",
              "PrimarySource": "SourceOutput"
            },
            "inputArtifacts": [
              { "name": "SourceOutput" },
              { "name": "BuildOutput" }
            ]
          }
        ]
      },
      {
        "name": "ApproveQA",
        "actions": [
          {
            "name": "ManualApproval",
            "actionTypeId": {
              "category": "Approval",
              "owner": "AWS",
              "provider": "Manual",
              "version": "1"
            },
            "configuration": {
              "CustomData": "Approve promotion of this digest from dev to qa (production). Verify the dev deployment is healthy before approving."
            }
          }
        ]
      },
      {
        "name": "PromoteQA",
        "actions": [
          {
            "name": "OpenQAPromotionPR",
            "actionTypeId": {
              "category": "Build",
              "owner": "AWS",
              "provider": "CodeBuild",
              "version": "1"
            },
            "configuration": {
              "ProjectName": "rumbles-promote-qa",
              "PrimarySource": "SourceOutput"
            },
            "inputArtifacts": [
              { "name": "SourceOutput" },
              { "name": "BuildOutput" }
            ]
          }
        ]
      }
    ]
  }
}
