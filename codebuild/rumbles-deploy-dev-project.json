{
  "name": "rumbles-deploy-dev",
  "description": "Promote the built digest into gitops envs/dev/values.yaml (direct commit)",
  "source": {
    "type": "CODEPIPELINE",
    "buildspec": "buildspec-deploy-dev.yml"
  },
  "artifacts": {
    "type": "CODEPIPELINE"
  },
  "environment": {
    "type": "LINUX_CONTAINER",
    "image": "aws/codebuild/amazonlinux2-x86_64-standard:5.0",
    "computeType": "BUILD_GENERAL1_SMALL",
    "privilegedMode": false
  },
  "serviceRole": "arn:aws:iam::849445096948:role/rumbles-deploy-dev",
  "logsConfig": {
    "cloudWatchLogs": {
      "status": "ENABLED",
      "groupName": "/aws/codebuild/rumbles-deploy-dev"
    }
  }
}
