{
  "name": "rumbles-promote-qa",
  "description": "Open a PR promoting the built digest into gitops envs/qa/values.yaml",
  "source": {
    "type": "CODEPIPELINE",
    "buildspec": "buildspec-promote-qa.yml"
  },
  "secondarySources": [
    {
      "type": "GITHUB",
      "location": "https://github.com/devanshpoplii/pg5-rumbles-gitops.git",
      "sourceIdentifier": "gitops",
      "auth": {
        "type": "CODECONNECTIONS",
        "resource": "arn:aws:codeconnections:eu-north-1:849445096948:connection/e70e301f-1be6-4f3f-aec8-ba30216004ab"
      }
    }
  ],
  "artifacts": {
    "type": "CODEPIPELINE"
  },
  "environment": {
    "type": "LINUX_CONTAINER",
    "image": "aws/codebuild/amazonlinux2-x86_64-standard:5.0",
    "computeType": "BUILD_GENERAL1_SMALL",
    "privilegedMode": false
  },
  "serviceRole": "arn:aws:iam::849445096948:role/rumbles-promote-qa",
  "logsConfig": {
    "cloudWatchLogs": {
      "status": "ENABLED",
      "groupName": "/aws/codebuild/rumbles-promote-qa"
    }
  }
}
