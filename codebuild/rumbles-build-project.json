{
  "name": "rumbles-build",
  "description": "Build the rumbles image, push to ECR, capture the immutable digest",
  "source": {
    "type": "CODEPIPELINE",
    "buildspec": "buildspec-build.yml"
  },
  "artifacts": {
    "type": "CODEPIPELINE"
  },
  "environment": {
    "type": "LINUX_CONTAINER",
    "image": "aws/codebuild/amazonlinux2-x86_64-standard:5.0",
    "computeType": "BUILD_GENERAL1_SMALL",
    "privilegedMode": true
  },
  "serviceRole": "arn:aws:iam::849445096948:role/rumbles-build",
  "logsConfig": {
    "cloudWatchLogs": {
      "status": "ENABLED",
      "groupName": "/aws/codebuild/rumbles-build"
    }
  }
}
