{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-north-1:849445096948:log-group:/aws/codebuild/rumbles-deploy-dev:*"
    },
    {
      "Sid": "UseCodeConnectionForGitAccess",
      "Effect": "Allow",
      "Action": [
        "codeconnections:GetConnectionToken",
        "codeconnections:GetConnection",
        "codeconnections:UseConnection"
      ],
      "Resource": "arn:aws:codeconnections:eu-north-1:849445096948:connection/8ebd7410-40aa-4b51-ab27-001af959fa3c"
    }
  ]
}
