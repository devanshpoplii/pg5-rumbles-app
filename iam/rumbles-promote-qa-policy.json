{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-north-1:849445096948:log-group:/aws/codebuild/rumbles-promote-qa:*"
    },
    {
      "Sid": "UseCodeConnectionForGitAccess",
      "Effect": "Allow",
      "Action": [
        "codeconnections:GetConnectionToken",
        "codeconnections:GetConnection",
        "codeconnections:UseConnection"
      ],
      "Resource": "arn:aws:codeconnections:eu-north-1:849445096948:connection/e70e301f-1be6-4f3f-aec8-ba30216004ab"
    }
  ]
}
