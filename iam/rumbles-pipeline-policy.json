{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArtifactBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::rumbles-pipeline-artifacts-849445096948",
        "arn:aws:s3:::rumbles-pipeline-artifacts-849445096948/*"
      ]
    },
    {
      "Sid": "RunCodeBuildProjects",
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "codebuild:BatchGetBuilds"
      ],
      "Resource": [
        "arn:aws:codebuild:eu-north-1:849445096948:project/rumbles-build",
        "arn:aws:codebuild:eu-north-1:849445096948:project/rumbles-deploy-dev"
      ]
    },
    {
      "Sid": "UseCodeConnectionForSource",
      "Effect": "Allow",
      "Action": [
        "codeconnections:UseConnection",
        "codestar-connections:UseConnection"
      ],
      "Resource": "arn:aws:codeconnections:eu-north-1:849445096948:connection/8ebd7410-40aa-4b51-ab27-001af959fa3c"
    }
  ]
}
